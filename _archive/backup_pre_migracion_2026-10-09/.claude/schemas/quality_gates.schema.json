{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CompuertasDeCalidadSIVAC",
  "description": "Definición y estado de cumplimiento de las compuertas de calidad (QG-0 a QG-9)",
  "type": "object",
  "properties": {
    "compuerta": {
      "type": "string",
      "enum": ["QG-0", "QG-1", "QG-2", "QG-3", "QG-4", "QG-5", "QG-6", "QG-7", "QG-8", "QG-9"],
      "description": "Identificador de la compuerta"
    },
    "nombre": {
      "type": "string"
    },
    "fase_asociada": {
      "type": "string"
    },
    "criterios_evaluacion": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterio": { "type": "string" },
          "metrica": { "type": "string" },
          "estado": { "type": "string", "enum": ["aprobado", "observado", "pendiente"] }
        },
        "required": ["criterio", "metrica", "estado"]
      }
    },
    "aprobacion_tesista": {
      "type": "boolean",
      "description": "Autorización formal e ineludible del tesista humano"
    }
  },
  "required": ["compuerta", "nombre", "fase_asociada", "criterios_evaluacion", "aprobacion_tesista"],
  "additionalProperties": false
}
